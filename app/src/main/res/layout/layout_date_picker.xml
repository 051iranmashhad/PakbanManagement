<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- RecyclerView for Year -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_year"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        android:scrollbars="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/tv_year_separator"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Separator "/" between Year and Month -->
    <TextView
        android:id="@+id/tv_year_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:text="/"
        android:textColor="@color/color_black"
        android:textSize="@dimen/_24ssp"
        app:fontFamily="@font/medium"
        app:layout_constraintBottom_toBottomOf="@id/rv_year"
        app:layout_constraintLeft_toRightOf="@id/rv_year"
        app:layout_constraintRight_toLeftOf="@id/rv_month"
        app:layout_constraintTop_toTopOf="@id/rv_year" />

    <!-- RecyclerView for Month -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_month"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        android:scrollbars="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/tv_year_separator"
        app:layout_constraintRight_toLeftOf="@id/tv_month_separator"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Separator "/" between Month and Day -->
    <TextView
        android:id="@+id/tv_month_separator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/medium"
        android:gravity="center"
        android:text="/"
        android:textColor="@color/color_black"
        android:textSize="@dimen/_24ssp"
        app:fontFamily="@font/medium"
        app:layout_constraintBottom_toBottomOf="@id/rv_month"
        app:layout_constraintLeft_toRightOf="@id/rv_month"
        app:layout_constraintRight_toLeftOf="@id/rv_day"
        app:layout_constraintTop_toTopOf="@id/rv_month" />

    <!-- RecyclerView for Day -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_day"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingVertical="@dimen/_8sdp"
        android:scrollbars="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@id/tv_month_separator"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
